APP_NAME=Laravel
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# REQUIRED: set to your real production URL (with https://). Leaving this as
# localhost is a common cause of "419 Page Expired" on login — the session
# cookie's domain won't match the real site, so the browser never stores it.
APP_URL=https://REPLACE_WITH_YOUR_DOMAIN
# Usually leave SESSION_DOMAIN unset (Laravel infers it from APP_URL). Only set
# it explicitly if you need the cookie shared across subdomains, and then use
# your bare domain (e.g. .example.com) — never "localhost" in production.
SESSION_DOMAIN=
SANCTUM_STATEFUL_DOMAINS=REPLACE_WITH_YOUR_DOMAIN

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=REPLACE_WITH_YOUR_DATABASE
DB_USERNAME=REPLACE_WITH_YOUR_DB_USER
DB_PASSWORD=REPLACE_WITH_YOUR_DB_PASSWORD

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# SESSION_SECURE_COOKIE=true is required if the site is served over https (it should be in production) —
# without it, browsers may refuse to send the cookie back, which also causes 419 on login.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

APP_ADMIN_EMAIL=admin@example.com
APP_ADMIN_PASSWORD=Password123!

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Stripe — set on the server / CI secrets only; never commit real values to git.
# Webhook: Developers → Webhooks → endpoint URL .../api/shop/webhooks/stripe → Signing secret = STRIPE_WEBHOOK_SECRET
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
