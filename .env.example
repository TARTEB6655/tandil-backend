APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Optional: base URL for images/assets (e.g. CDN). If set, product/category image_url in API use this instead of APP_URL.
# ASSET_URL=https://cdn.yourdomain.com
SESSION_DOMAIN=localhost
SANCTUM_STATEFUL_DOMAINS=127.0.0.1:8000,localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

APP_ADMIN_EMAIL=admin@example.com
APP_ADMIN_PASSWORD=Password123!

# API POST /api/auth/login: require JSON body field "portal" (client|technician|supervisor|area_manager|hr|admin). Set false only for legacy apps.
API_LOGIN_PORTAL_REQUIRED=true

# Social sign-in (POST /api/auth/google, POST /api/auth/apple). Use OAuth client ID(s) from Google Cloud / Apple Developer.
# GOOGLE_CLIENT_IDS=ios-client-id.apps.googleusercontent.com,android-client-id.apps.googleusercontent.com
PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_IDS=
# Sign in with Apple (POST /api/auth/apple) — NOT Apple Pay.
# iOS app only: set Bundle ID (Xcode → target → Bundle Identifier). Token `aud` must match.
# PUBLIC_APPLE_BUNDLE_ID=com.yourcompany.tandil
# Web + iOS: comma-separate Bundle ID and Services ID
# APPLE_CLIENT_IDS=com.yourcompany.tandil,com.yourcompany.tandil.web
PUBLIC_APPLE_BUNDLE_ID=
APPLE_BUNDLE_ID=
APPLE_CLIENT_ID=
APPLE_CLIENT_IDS=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Shop payments: Stripe + PayPal (configure keys in Admin → Payments, or use env fallbacks below for local/testing)
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_SANDBOX=true

# Stripe — publishable + secret: https://dashboard.stripe.com/test/apikeys (Standard keys)
# Webhook signing secret (whsec_...): NOT on the API keys page. Add an endpoint under
# Developers → Webhooks → Add endpoint → URL = https://YOUR-DOMAIN/api/shop/webhooks/stripe
# → select events (at least checkout.session.completed) → Reveal "Signing secret".
# Local: run `stripe listen --forward-to http://127.0.0.1:8000/api/shop/webhooks/stripe` and paste the whsec_ value here.
# Stripe — set STRIPE_MODE to test or live; store both key pairs (admin dashboard preferred).
STRIPE_MODE=test
STRIPE_TEST_PUBLISHABLE_KEY=
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_WEBHOOK_SECRET=
STRIPE_LIVE_PUBLISHABLE_KEY=
STRIPE_LIVE_SECRET_KEY=
STRIPE_LIVE_WEBHOOK_SECRET=
# Legacy single-pair fallback (used when mode-specific env vars above are empty)
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# OpenStreetMap Nominatim: forward-geocode typed addresses (any language) when lat/lng are omitted.
# Disable in tests via phpunit.xml or set false. Use a stable User-Agent in production (NOMINATIM_USER_AGENT).
NOMINATIM_FORWARD_GEOCODE_ENABLED=true
# NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# NOMINATIM_TIMEOUT=10
# NOMINATIM_USER_AGENT="MyApp/1.0 (https://myapp.com/contact)"
