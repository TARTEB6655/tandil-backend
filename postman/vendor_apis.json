{
    "info": {
        "name": "Tandil Vendor APIs",
        "description": "Edit Profile: GET + POST /api/vendor/profile — UI field names only."
    },
    "item": [
        {
            "name": "Vendor",
            "item": [
                {
                    "name": "Profile",
                    "item": [
                        {
                            "name": "1. Get profile",
                            "request": {
                                "method": "GET",
                                "header": [
                                    {"key": "Authorization", "value": "Bearer {{vendor_token}}"},
                                    {"key": "Accept", "value": "application/json"}
                                ],
                                "url": "{{base_url}}/api/vendor/profile"
                            }
                        },
                        {
                            "name": "2. Update profile",
                            "request": {
                                "method": "POST",
                                "header": [
                                    {"key": "Authorization", "value": "Bearer {{vendor_token}}"},
                                    {"key": "Accept", "value": "application/json"}
                                ],
                                "body": {
                                    "mode": "formdata",
                                    "formdata": [
                                        {"key": "business_name", "value": "Green Fields Agro Supplies", "type": "text"},
                                        {"key": "contact_person", "value": "Ali Vendor", "type": "text"},
                                        {"key": "phone", "value": "+971500000001", "type": "text"},
                                        {"key": "address", "value": "Industrial Area 1", "type": "text"},
                                        {"key": "city", "value": "Al Ain", "type": "text"},
                                        {"key": "store_description", "value": "Store description", "type": "text"},
                                        {"key": "opens_at", "value": "09:00", "type": "text"},
                                        {"key": "closes_at", "value": "22:00", "type": "text"},
                                        {"key": "delivery_radius_km", "value": "25", "type": "text"},
                                        {"key": "minimum_order_amount", "value": "50", "type": "text"},
                                        {"key": "bank_name", "value": "Emirates NBD", "type": "text"},
                                        {"key": "iban", "value": "AE070331234567890123456", "type": "text"},
                                        {"key": "account_holder_name", "value": "Green Fields Agro Supplies", "type": "text"},
                                        {"key": "logo", "type": "file", "src": []}
                                    ]
                                },
                                "url": "{{base_url}}/api/vendor/profile"
                            }
                        }
                    ]
                }
            ]
        }
    ]
}
