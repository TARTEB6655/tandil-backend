{
    "info": {
        "name": "Tandil Vendor APIs",
        "description": "Vendor profile: GET + POST /api/vendor/profile only. Login via main collection folder 2."
    },
    "item": [
        {
            "name": "Vendor",
            "item": [
                {
                    "name": "Profile",
                    "description": "GET = complete profile. POST = vendor-editable fields only (no password/status/commission).",
                    "item": [
                        {
                            "name": "Get profile",
                            "request": {
                                "method": "GET",
                                "header": [
                                    {"key": "Authorization", "value": "Bearer {{vendor_token}}"},
                                    {"key": "Accept", "value": "application/json"}
                                ],
                                "url": "{{base_url}}/api/vendor/profile"
                            }
                        },
                        {
                            "name": "Update profile",
                            "request": {
                                "method": "POST",
                                "header": [
                                    {"key": "Authorization", "value": "Bearer {{vendor_token}}"},
                                    {"key": "Accept", "value": "application/json"}
                                ],
                                "body": {
                                    "mode": "formdata",
                                    "formdata": [
                                        {"key": "owner_name", "value": "Ali Vendor", "type": "text"},
                                        {"key": "phone", "value": "+971500000001", "type": "text"},
                                        {"key": "business_name", "value": "Green Fields Agro Supplies", "type": "text"},
                                        {"key": "description", "value": "Updated description", "type": "text"},
                                        {"key": "logo", "type": "file", "src": []}
                                    ]
                                },
                                "url": "{{base_url}}/api/vendor/profile"
                            }
                        }
                    ]
                }
            ]
        }
    ]
}
