{
    "info": {
        "name": "Tandil Vendor APIs",
        "description": "Vendor profile: GET screens + POST only for Update profile (Edit Profile)."
    },
    "item": [
        {
            "name": "Vendor",
            "item": [
                {
                    "name": "Profile",
                    "item": [
                        {
                            "name": "1. Get profile",
                            "request": {
                                "method": "GET",
                                "header": [
                                    {"key": "Authorization", "value": "Bearer {{vendor_token}}"},
                                    {"key": "Accept", "value": "application/json"}
                                ],
                                "url": "{{base_url}}/api/vendor/profile"
                            }
                        },
                        {
                            "name": "2. Update profile",
                            "request": {
                                "method": "POST",
                                "header": [
                                    {"key": "Authorization", "value": "Bearer {{vendor_token}}"},
                                    {"key": "Accept", "value": "application/json"}
                                ],
                                "body": {
                                    "mode": "formdata",
                                    "formdata": [
                                        {"key": "owner_name", "value": "Ali Vendor", "type": "text"},
                                        {"key": "phone", "value": "+971500000001", "type": "text"},
                                        {"key": "description", "value": "Store description", "type": "text"},
                                        {"key": "logo", "type": "file", "src": []}
                                    ]
                                },
                                "url": "{{base_url}}/api/vendor/profile"
                            }
                        },
                        {
                            "name": "3. Business Information",
                            "request": {
                                "method": "GET",
                                "header": [
                                    {"key": "Authorization", "value": "Bearer {{vendor_token}}"},
                                    {"key": "Accept", "value": "application/json"}
                                ],
                                "url": "{{base_url}}/api/vendor/profile"
                            }
                        },
                        {
                            "name": "4. Location & Address",
                            "request": {
                                "method": "GET",
                                "header": [
                                    {"key": "Authorization", "value": "Bearer {{vendor_token}}"},
                                    {"key": "Accept", "value": "application/json"}
                                ],
                                "url": "{{base_url}}/api/vendor/profile"
                            }
                        },
                        {
                            "name": "5. Payment Methods",
                            "request": {
                                "method": "GET",
                                "header": [
                                    {"key": "Authorization", "value": "Bearer {{vendor_token}}"},
                                    {"key": "Accept", "value": "application/json"}
                                ],
                                "url": "{{base_url}}/api/vendor/profile"
                            }
                        }
                    ]
                }
            ]
        }
    ]
}
