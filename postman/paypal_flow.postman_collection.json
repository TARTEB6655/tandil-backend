{
  "info": {
    "name": "Tandil Backend - PayPal Flow",
    "_postman_id": "paypal-flow",
    "description": "Minimal PayPal flow examples: create order, webhook sample, mark-paid.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create PayPal Order (Subscription)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{auth_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"type\": \"subscription\",\n  \"id\": 1,\n  \"return_url\": \"http://localhost:3000/paypal-return\",\n  \"cancel_url\": \"http://localhost:3000/paypal-cancel\"\n}"
        },
        "url": { "raw": "{{base_url}}/api/payments/paypal/create", "host": ["{{base_url}}"], "path": ["api","payments","paypal","create"] }
      }
    },
    {
      "name": "Simulate PayPal Webhook (capture)",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"event_type\": \"PAYMENT.CAPTURE.COMPLETED\",\n  \"resource\": { \"id\": \"PP_FAKE_12345\" }\n}"
        },
        "url": { "raw": "{{base_url}}/api/payments/paypal/webhook", "host": ["{{base_url}}"], "path": ["api","payments","paypal","webhook"] }
      }
    },
    {
      "name": "Manual mark-paid (subscription)",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{auth_token}}" } ],
        "url": { "raw": "{{base_url}}/api/subscriptions/1/mark-paid", "host": ["{{base_url}}"], "path": ["api","subscriptions","1","mark-paid"] }
      }
    }
  ]
}
