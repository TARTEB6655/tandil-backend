{
  "info": {
    "name": "Tandil Backend - Full API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.1.0",
    "description": "Full Tandil backend API collection for frontend integration and smoke tests. Import this into Postman and import the accompanying environment."
  },
  "item": [
    {
      "name": "Health",
      "request": { "method": "GET", "header": [], "url": { "raw": "{{base_url}}/api/health", "host": ["{{base_url}}"], "path": ["api","health"] } }
    },

    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Frontend User\",\n  \"email\": \"user+{{timestamp}}@example.com\",\n  \"password\": \"password123\",\n  \"password_confirmation\": \"password123\",\n  \"phone\": \"70000002\"\n}" },
            "url": { "raw": "{{base_url}}/api/auth/register", "host": ["{{base_url}}"], "path": ["api","auth","register"] }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}" },
            "url": { "raw": "{{base_url}}/api/auth/login", "host": ["{{base_url}}"], "path": ["api","auth","login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json && json.token) { pm.environment.set('token', json.token); }",
                  "pm.environment.set('timestamp', new Date().getTime());",
                  "pm.test('Login returned token', function () { pm.expect(json.token).to.exist; });"
                ]
              }
            }
          ]
        },
        {
          "name": "Profile",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": { "raw": "{{base_url}}/api/auth/profile", "host": ["{{base_url}}"], "path": ["api","auth","profile"] } }
        },
        {
          "name": "Logout",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": { "raw": "{{base_url}}/api/auth/logout", "host": ["{{base_url}}"], "path": ["api","auth","logout"] } }
        }
      ]
    },

    {
      "name": "Admin",
      "item": [
        {
          "name": "Users - List",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": { "raw": "{{base_url}}/api/admin/users", "host": ["{{base_url}}"], "path": ["api","admin","users"] } }
        },
        {
          "name": "Users - Create",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"New User\",\n  \"email\": \"new.user+{{timestamp}}@example.com\",\n  \"password\": \"password123\",\n  \"password_confirmation\": \"password123\",\n  \"phone\": \"70000003\",\n  \"role\": \"client\"\n}" },
            "url": { "raw": "{{base_url}}/api/admin/users", "host": ["{{base_url}}"], "path": ["api","admin","users"] }
          }
        },
        {
          "name": "Users - Show",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": { "raw": "{{base_url}}/api/admin/users/{{user_id}}", "host": ["{{base_url}}"], "path": ["api","admin","users","{{user_id}}"] } }
        },
        {
          "name": "Users - Update",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Updated Name\"\n}" },
            "url": { "raw": "{{base_url}}/api/admin/users/{{user_id}}", "host": ["{{base_url}}"], "path": ["api","admin","users","{{user_id}}"] }
          }
        },
        {
          "name": "Users - Delete",
          "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": { "raw": "{{base_url}}/api/admin/users/{{user_id}}", "host": ["{{base_url}}"], "path": ["api","admin","users","{{user_id}}"] } }
        },

        {
          "name": "Roles - List",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": { "raw": "{{base_url}}/api/admin/roles", "host": ["{{base_url}}"], "path": ["api","admin","roles"] } }
        },
        {
          "name": "Roles - Create",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"new_role\"\n}" },
            "url": { "raw": "{{base_url}}/api/admin/roles", "host": ["{{base_url}}"], "path": ["api","admin","roles"] }
          }
        },

        {
          "name": "HR - Employees - List",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": { "raw": "{{base_url}}/api/admin/hr/employees", "host": ["{{base_url}}"], "path": ["api","admin","hr","employees"] } }
        }
      ]
    },

    {
      "name": "Subscriptions",
      "item": [
        { "name": "List", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": { "raw": "{{base_url}}/api/subscriptions", "host": ["{{base_url}}"], "path": ["api","subscriptions"] } } },
        { "name": "Create", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }], "body": { "mode": "raw", "raw": "{\n  \"plan\": \"1_month\",\n  \"start_date\": \"2025-11-28\",\n  \"amount\": 100.00\n}" }, "url": { "raw": "{{base_url}}/api/subscriptions", "host": ["{{base_url}}"], "path": ["api","subscriptions"] } } },
        { "name": "Show", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": { "raw": "{{base_url}}/api/subscriptions/{{subscription_id}}", "host": ["{{base_url}}"], "path": ["api","subscriptions","{{subscription_id}}"] } } },
        { "name": "Update", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }], "body": { "mode": "raw", "raw": "{\n  \"payment_status\": \"paid\"\n}" }, "url": { "raw": "{{base_url}}/api/subscriptions/{{subscription_id}}", "host": ["{{base_url}}"], "path": ["api","subscriptions","{{subscription_id}}"] } } },
        { "name": "Delete", "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": { "raw": "{{base_url}}/api/subscriptions/{{subscription_id}}", "host": ["{{base_url}}"], "path": ["api","subscriptions","{{subscription_id}}"] } } }
      ]
    },

    {
      "name": "Visits",
      "item": [
        { "name": "List", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": { "raw": "{{base_url}}/api/visits", "host": ["{{base_url}}"], "path": ["api","visits"] } } },
        { "name": "Create", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }], "body": { "mode": "raw", "raw": "{\n  \"subscription_id\": {{subscription_id}},\n  \"technician_id\": null,\n  \"scheduled_date\": \"2025-12-01\"\n}" }, "url": { "raw": "{{base_url}}/api/visits", "host": ["{{base_url}}"], "path": ["api","visits"] } } },
        { "name": "Show", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": { "raw": "{{base_url}}/api/visits/{{visit_id}}", "host": ["{{base_url}}"], "path": ["api","visits","{{visit_id}}"] } } },
        { "name": "Update", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }], "body": { "mode": "raw", "raw": "{\n  \"status\": \"completed\"\n}" }, "url": { "raw": "{{base_url}}/api/visits/{{visit_id}}", "host": ["{{base_url}}"], "path": ["api","visits","{{visit_id}}"] } } },
        { "name": "Upload Photo (form-data)", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "body": { "mode": "formdata", "formdata": [ { "key": "type", "value": "before", "type": "text" }, { "key": "photo", "type": "file" } ] }, "url": { "raw": "{{base_url}}/api/visits/{{visit_id}}/upload-photo", "host": ["{{base_url}}"], "path": ["api","visits","{{visit_id}}","upload-photo"] } } }
      ]
    },

    {
      "name": "Reports",
      "item": [
        { "name": "List", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": { "raw": "{{base_url}}/api/reports", "host": ["{{base_url}}"], "path": ["api","reports"] } } },
        { "name": "Create", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }], "body": { "mode": "raw", "raw": "{\n  \"visit_id\": {{visit_id}},\n  \"technician_notes\": \"Notes from technician\",\n  \"supervisor_notes\": \"Supervisor notes\",\n  \"recommendations\": [1,2]\n}" }, "url": { "raw": "{{base_url}}/api/reports", "host": ["{{base_url}}"], "path": ["api","reports"] } } },
        { "name": "Show", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": { "raw": "{{base_url}}/api/reports/{{report_id}}", "host": ["{{base_url}}"], "path": ["api","reports","{{report_id}}"] } } }
      ]
    },

    {
      "name": "Shop",
      "item": [
        { "name": "Products - List", "request": { "method": "GET", "header": [], "url": { "raw": "{{base_url}}/api/shop/products", "host": ["{{base_url}}"], "path": ["api","shop","products"] } } },
        { "name": "Products - Show", "request": { "method": "GET", "header": [], "url": { "raw": "{{base_url}}/api/shop/products/{{product_id}}", "host": ["{{base_url}}"], "path": ["api","shop","products","{{product_id}}"] } } },

        { "name": "Cart - Add", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }], "body": { "mode": "raw", "raw": "{\n  \"product_id\": {{product_id}},\n  \"quantity\": 1\n}" }, "url": { "raw": "{{base_url}}/api/shop/cart/add", "host": ["{{base_url}}"], "path": ["api","shop","cart","add"] } } },
        { "name": "Cart - View", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": { "raw": "{{base_url}}/api/shop/cart", "host": ["{{base_url}}"], "path": ["api","shop","cart"] } } },
        { "name": "Cart - Remove", "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": { "raw": "{{base_url}}/api/shop/cart/{{cart_item_id}}", "host": ["{{base_url}}"], "path": ["api","shop","cart","{{cart_item_id}}"] } } },

        { "name": "Checkout", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }], "body": { "mode": "raw", "raw": "{\n  \"payment_method\": \"card\"\n}" }, "url": { "raw": "{{base_url}}/api/shop/checkout", "host": ["{{base_url}}"], "path": ["api","shop","checkout"] } } },
        { "name": "Orders - List", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": { "raw": "{{base_url}}/api/shop/orders", "host": ["{{base_url}}"], "path": ["api","shop","orders"] } } },
        { "name": "Orders - Show", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": { "raw": "{{base_url}}/api/shop/orders/{{order_id}}", "host": ["{{base_url}}"], "path": ["api","shop","orders","{{order_id}}"] } } }
      ]
    },

    {
      "name": "Tips & Notifications",
      "item": [
        { "name": "Tips - List", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": { "raw": "{{base_url}}/api/tips", "host": ["{{base_url}}"], "path": ["api","tips"] } } },
        { "name": "Notifications - List", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": { "raw": "{{base_url}}/api/notifications", "host": ["{{base_url}}"], "path": ["api","notifications"] } } }
      ]
    }
  ],
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000" },
    { "key": "admin_email", "value": "admin@example.com" },
    { "key": "admin_password", "value": "Password123!" },
    { "key": "token", "value": "" },
    { "key": "user_id", "value": "1" },
    { "key": "subscription_id", "value": "1" },
    { "key": "visit_id", "value": "1" },
    { "key": "report_id", "value": "1" },
    { "key": "product_id", "value": "1" },
    { "key": "cart_item_id", "value": "1" },
    { "key": "order_id", "value": "1" },
    { "key": "timestamp", "value": "" }
  ]
}

