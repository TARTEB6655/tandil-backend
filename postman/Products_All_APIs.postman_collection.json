{
    "info": {
        "name": "Products - All APIs (Single Module)",
        "description": "Single module for all product APIs: Public (no auth) and Admin (Bearer token). Set base_url (e.g. http://127.0.0.1:8000) and token (from Login) for Admin requests.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Public (no auth)",
            "item": [
                {
                    "name": "List Products",
                    "request": {
                        "method": "GET",
                        "header": [{"key": "Accept", "value": "application/json"}],
                        "url": "{{base_url}}/api/shop/products?per_page=12",
                        "description": "List products for shop/customer app. Query: per_page, search, category_id, status, sort_by, sort_dir."
                    }
                },
                {
                    "name": "Get Product Details",
                    "request": {
                        "method": "GET",
                        "header": [{"key": "Accept", "value": "application/json"}],
                        "url": "{{base_url}}/api/shop/products/{{product_id}}",
                        "description": "Get single product by ID or handle."
                    }
                },
                {
                    "name": "Search Products",
                    "request": {
                        "method": "GET",
                        "header": [{"key": "Accept", "value": "application/json"}],
                        "url": "{{base_url}}/api/shop/products?search=fertilizer&per_page=12",
                        "description": "Search by name, description, tags. Use query param: search."
                    }
                },
                {
                    "name": "Get Categories",
                    "request": {
                        "method": "GET",
                        "header": [{"key": "Accept", "value": "application/json"}],
                        "url": "{{base_url}}/api/shop/products/categories",
                        "description": "Get all product categories with product count."
                    }
                },
                {
                    "name": "Get Products by Category",
                    "request": {
                        "method": "GET",
                        "header": [{"key": "Accept", "value": "application/json"}],
                        "url": "{{base_url}}/api/shop/products/category/{{category_id}}",
                        "description": "Get products in a category. Set category_id (e.g. 1)."
                    }
                }
            ],
            "description": "Public product APIs – no Authorization header. Use for customer/storefront app."
        },
        {
            "name": "Admin (Bearer token)",
            "item": [
                {
                    "name": "List Products",
                    "request": {
                        "method": "GET",
                        "header": [
                            {"key": "Authorization", "value": "Bearer {{token}}"},
                            {"key": "Accept", "value": "application/json"}
                        ],
                        "url": "{{base_url}}/api/admin/products?search=&category_id=&filter=all",
                        "description": "List all products (admin). Query: search, category_id, filter (all|active|draft|archived)."
                    }
                },
                {
                    "name": "Add Product",
                    "request": {
                        "method": "POST",
                        "header": [
                            {"key": "Authorization", "value": "Bearer {{token}}"},
                            {"key": "Accept", "value": "application/json"}
                        ],
                        "body": {
                            "mode": "formdata",
                            "formdata": [
                                {"key": "name", "value": "Test Product", "type": "text"},
                                {"key": "description", "value": "Description here", "type": "text"},
                                {"key": "price", "value": "99.99", "type": "text"},
                                {"key": "stock", "value": "10", "type": "text"},
                                {"key": "status", "value": "active", "type": "text"},
                                {"key": "category_id", "value": "1", "type": "text"},
                                {"key": "weight_unit", "value": "kg", "type": "text"},
                                {"key": "images[]", "type": "file", "src": []}
                            ]
                        },
                        "url": "{{base_url}}/api/admin/products",
                        "description": "Create product. Use multipart/form-data. Required: name, price. Images: key \"images[]\" (multiple) or \"image\" (single)."
                    }
                },
                {
                    "name": "Get Product Details",
                    "request": {
                        "method": "GET",
                        "header": [
                            {"key": "Authorization", "value": "Bearer {{token}}"},
                            {"key": "Accept", "value": "application/json"}
                        ],
                        "url": "{{base_url}}/api/admin/products/{{product_id}}",
                        "description": "Get single product (admin)."
                    }
                },
                {
                    "name": "Update Product",
                    "request": {
                        "method": "PUT",
                        "header": [
                            {"key": "Authorization", "value": "Bearer {{token}}"},
                            {"key": "Content-Type", "value": "application/json"},
                            {"key": "Accept", "value": "application/json"}
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"name\": \"Updated Name\",\n  \"price\": 149.99,\n  \"stock\": 20,\n  \"status\": \"active\"\n}"
                        },
                        "url": "{{base_url}}/api/admin/products/{{product_id}}",
                        "description": "Update product."
                    }
                },
                {
                    "name": "Delete Product",
                    "request": {
                        "method": "DELETE",
                        "header": [
                            {"key": "Authorization", "value": "Bearer {{token}}"},
                            {"key": "Accept", "value": "application/json"}
                        ],
                        "url": "{{base_url}}/api/admin/products/{{product_id}}",
                        "description": "Delete product."
                    }
                },
                {
                    "name": "Toggle Status",
                    "request": {
                        "method": "POST",
                        "header": [
                            {"key": "Authorization", "value": "Bearer {{token}}"},
                            {"key": "Accept", "value": "application/json"}
                        ],
                        "url": "{{base_url}}/api/admin/products/{{product_id}}/toggle-status",
                        "description": "Toggle product status (active/draft/archived)."
                    }
                },
                {
                    "name": "Bulk Delete",
                    "request": {
                        "method": "POST",
                        "header": [
                            {"key": "Authorization", "value": "Bearer {{token}}"},
                            {"key": "Content-Type", "value": "application/json"},
                            {"key": "Accept", "value": "application/json"}
                        ],
                        "body": {"mode": "raw", "raw": "{\n  \"ids\": [1, 2, 3]\n}"},
                        "url": "{{base_url}}/api/admin/products/bulk-delete",
                        "description": "Bulk delete products."
                    }
                },
                {
                    "name": "Bulk Update Status",
                    "request": {
                        "method": "POST",
                        "header": [
                            {"key": "Authorization", "value": "Bearer {{token}}"},
                            {"key": "Content-Type", "value": "application/json"},
                            {"key": "Accept", "value": "application/json"}
                        ],
                        "body": {"mode": "raw", "raw": "{\n  \"ids\": [1, 2, 3],\n  \"status\": \"active\"\n}"},
                        "url": "{{base_url}}/api/admin/products/bulk-update-status",
                        "description": "Bulk update product status."
                    }
                },
                {
                    "name": "Bulk Update Stock",
                    "request": {
                        "method": "POST",
                        "header": [
                            {"key": "Authorization", "value": "Bearer {{token}}"},
                            {"key": "Content-Type", "value": "application/json"},
                            {"key": "Accept", "value": "application/json"}
                        ],
                        "body": {"mode": "raw", "raw": "{\n  \"ids\": [1, 2, 3],\n  \"stock\": 100\n}"},
                        "url": "{{base_url}}/api/admin/products/bulk-update-stock",
                        "description": "Bulk update product stock."
                    }
                }
            ],
            "description": "Admin product APIs – require Authorization: Bearer {{token}}. Get token from POST /api/auth/login (admin user)."
        }
    ],
    "variable": [
        {"key": "base_url", "value": "http://127.0.0.1:8000"},
        {"key": "token", "value": ""},
        {"key": "product_id", "value": "1"},
        {"key": "category_id", "value": "1"}
    ]
}
